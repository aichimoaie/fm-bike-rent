# Copy this file to .env and fill in real values.

# Owner's WhatsApp number, digits only, international format, no "+".
# e.g. a Moroccan mobile: 2126XXXXXXXX
PUBLIC_OWNER_WHATSAPP_NUMBER=0000000000

# Owner's Instagram handle, no "@". Shown/linked in the homepage Instagram section.
PUBLIC_OWNER_INSTAGRAM_HANDLE=filiosbike

# Google Business Profile review/listing link, shown in the homepage Reviews section.
# Placeholder until the business has a real Google listing.
PUBLIC_GOOGLE_REVIEW_URL=https://g.page/r/placeholder/review

# TripAdvisor listing link, shown in the homepage Reviews section.
# Placeholder until the business has a real TripAdvisor listing.
PUBLIC_TRIPADVISOR_URL=https://www.tripadvisor.com/placeholder

# Password for the /admin reservations page (HTTP Basic Auth, username "admin").
# Required — /admin returns 503 until this is set.
ADMIN_PASSWORD=changeme
